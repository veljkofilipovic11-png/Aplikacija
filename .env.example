# --- Portal ---
PORTAL_BASE_URL=https://jnportal.ujn.gov.rs
PLAYWRIGHT_HEADLESS=true
REQUEST_TIMEOUT_SECONDS=30

# --- Proxy fallback (opciono, samo ako portal pocne da blokira po IP-u) ---
# PROXY_PROVIDER: none | scrapingbee | zenrows
PROXY_PROVIDER=none
SCRAPINGBEE_API_KEY=
ZENROWS_API_KEY=

# --- Skladiste ---
DOWNLOADS_DIR=./data/downloads
DB_PATH=./data/tenders.db

# --- Mobilni dashboard ---
# Generisi DASHBOARD_SECRET_KEY sa: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_PASSWORD=
DASHBOARD_SECRET_KEY=
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# --- KORAK 3: OpenAI (kasnije) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- KORAK 4: Notifikacije (kasnije) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RELEVANCE_THRESHOLD=7
